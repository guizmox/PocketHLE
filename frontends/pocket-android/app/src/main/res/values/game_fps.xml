<resources>
    <!-- Shared by both console layouts: same discreet Gizmondo FPS overlay. -->
    <style name="GameFpsOverlay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#DDFFFFFF</item>
        <item name="android:background">#60000000</item>
        <item name="android:visibility">gone</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
