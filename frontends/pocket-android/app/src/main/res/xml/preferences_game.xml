<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:key="controls_category" android:title="Controls">
        <ListPreference android:key="dpad_deadzone" android:title="D-pad dead zone" android:entries="@array/dpad_deadzone_entries" android:entryValues="@array/dpad_deadzone_values" android:defaultValue="large" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory android:key="graphics_category" android:title="Graphics">
        <ListPreference android:key="frame_rate_limit" android:title="Frame rate limit" android:persistent="false" />
        <ListPreference android:key="screen" android:title="@string/pref_screen_title" android:entries="@array/screen_entries" android:entryValues="@array/screen_values" android:defaultValue="portrait" />
        <ListPreference android:key="rotation" android:title="@string/pref_rotation_title" android:summary="@string/pref_rotation_summary" android:entries="@array/rotation_entries" android:entryValues="@array/rotation_values" android:defaultValue="none" />
        <ListPreference android:key="gpu_renderer_mode" android:title="GPU rendering" android:summary="Host OpenGL; restart the game to apply. Falls back to software if unavailable." android:defaultValue="inherit" />
        <ListPreference android:key="anisotropic_filtering" android:title="Anisotropic filtering (GPU only)" android:summary="Sharper textures at oblique angles; limited by the GPU driver." android:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="sound_category" android:title="Sound">
        <Preference android:title="No per-game sound options yet." android:selectable="false" android:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="device_identity_category" android:title="Device Identity">
    </PreferenceCategory>
</PreferenceScreen>
